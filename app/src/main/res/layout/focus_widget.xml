<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp" android:background="@drawable/widget_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="FocuLY" android:textColor="#202520" android:textSize="14sp" android:fontFamily="@font/jetbrains_mono" />
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Make room for what matters." android:textSize="18sp" android:textColor="#252328" android:fontFamily="@font/jetbrains_mono" />
    <Button android:id="@+id/widget_action" android:layout_width="match_parent" android:layout_height="48dp" android:text="Start focus" android:fontFamily="@font/jetbrains_mono" />
</LinearLayout>
