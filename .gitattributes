# Keep source reproducible across Windows, macOS, Linux and GitHub runners.
* text=auto
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.pro text eol=lf
*.svg text eol=lf
*.example text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
gradlew text eol=lf
*.bat text eol=crlf
*.png binary
*.jpg binary
*.ttf binary
*.jar binary
